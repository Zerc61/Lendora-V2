{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,backend/node_modules/**,.git/**,dist/**,src/**,public/**,scripts/**,test-results/**,.kilo/**,.env.local,backend/.env,backend/.env.*,backend/tests/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.php" },
    { "source": "/up", "destination": "/api/index.php" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
